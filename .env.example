DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
BETTER_AUTH_SECRET="change-me-to-a-long-random-secret-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Cloudinary (server-only — never NEXT_PUBLIC_*)
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Do NOT wrap key/secret in <angle brackets> — uploads will fail with Invalid api_key / Invalid Signature.
# Required for persistent uploads in production. Locally, uploads fall back to ./uploads if Cloudinary auth fails.
CLOUDINARY_URL=
# Optional folder prefix (default: sunbuild)
CLOUDINARY_FOLDER=sunbuild
# Set to 1 to allow local disk fallback even in production (not recommended on ephemeral hosts)
# FILE_STORAGE_ALLOW_LOCAL_FALLBACK=1

# UPLOAD_DIR is legacy only; new uploads go to Cloudinary, not disk.
# UPLOAD_DIR="./uploads"

# Email delivery (never NEXT_PUBLIC_*):
# - Local / paid hosts: Google SMTP (Nodemailer) works on ports 465/587.
# - Render Free blocks outbound SMTP (25/465/587). Use Resend HTTPS instead:
#   https://resend.com → API Keys → set RESEND_API_KEY (+ verified from domain/address).
# If both are set, Resend is preferred.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Sunbuild
# RESEND_REPLY_TO=you@example.com

# Google SMTP (Nodemailer) — for local / paid Render
# For Gmail: enable 2-Step Verification, then create an App Password
# (Google Account → Security → App passwords). Paste the 16-char password
# into SMTP_PASSWORD (spaces optional). Restart after changes.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Sunbuild
SMTP_REPLY_TO=your-email@gmail.com

# Google Calendar OAuth (server-side only — never NEXT_PUBLIC_*)
# Create OAuth client in Google Cloud Console with redirect URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/calendar/callback

# Microsoft To Do OAuth (server-side only — never NEXT_PUBLIC_*)
# Create an app in Azure Portal → Microsoft Entra ID → App registrations.
# Add redirect URI below. API permissions: Tasks.ReadWrite, User.Read, offline_access.
# MICROSOFT_TENANT_ID:
#   consumers = personal Microsoft accounts only (Matches Audience: Personal)
#   organizations = work/school accounts only
#   common = both (Requires Audience: Accounts in any org + personal)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=consumers
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/microsoft/todo/callback

# Production checklist:
# - Use PostgreSQL (not SQLite) and rotate BETTER_AUTH_SECRET
# - Set NEXT_PUBLIC_APP_URL / BETTER_AUTH_URL to https://your-domain
# - Configure RESEND_API_KEY on Render Free (SMTP ports are blocked), or SMTP_* on paid hosts — .env.local is local-only
# - Set GOOGLE_* and update GOOGLE_REDIRECT_URI to your production callback URL
# - Set MICROSOFT_* and update MICROSOFT_REDIRECT_URI to your production callback URL
# - Enable automated DB + uploads backups
# - Run `npx prisma db push` after pulling schema changes (AppSetting, twoFactor)
# Days ahead counted as Upcoming Deadlines on Jobs Management
JOBS_UPCOMING_DEADLINE_DAYS=30
# Budget utilization % that triggers a Jobs insight warning
JOBS_BUDGET_WARNING_PERCENT=85
