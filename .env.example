DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
BETTER_AUTH_SECRET="change-me-to-a-long-random-secret-min-32-chars"
# Public app origin (browser redirects, emails, OAuth post-callback).
# Never use Render's PORT here — that is an internal listen port only.
APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Cloudinary (server-only — never NEXT_PUBLIC_*)
# Use the SAME credentials on localhost (.env.local) and Render (Environment).
# Preferred — one URL (Render: Environment → CLOUDINARY_URL):
#   cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Alternate — dashboard fields only (do not mix with a different CLOUDINARY_URL):
#   CLOUDINARY_CLOUD_NAME=
#   CLOUDINARY_API_KEY=
#   CLOUDINARY_API_SECRET=
# Do NOT wrap key/secret in <angle brackets> or quotes.
# If uploads say "api_secret mismatch", the secret is wrong even if the URL
# "looks" right — regenerate in Cloudinary Dashboard → Settings → API Keys,
# paste the new CLOUDINARY_URL, delete leftover CLOUDINARY_API_* on Render,
# then restart. Verify locally: npx tsx scripts/verify-cloudinary.ts
CLOUDINARY_URL=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Optional folder prefix (default: sunbuild)
CLOUDINARY_FOLDER=sunbuild
# Set to 1 to allow local disk fallback even in production (not recommended on ephemeral hosts)
# FILE_STORAGE_ALLOW_LOCAL_FALLBACK=1

# UPLOAD_DIR is legacy only; new uploads go to Cloudinary, not disk.
# UPLOAD_DIR="./uploads"

# Email delivery (never NEXT_PUBLIC_*):
# - Local / paid hosts: Google SMTP (Nodemailer) works on ports 465/587.
# - Render Free blocks outbound SMTP (25/465/587). Use Resend HTTPS instead:
#   https://resend.com → API Keys → set RESEND_API_KEY (+ verified from domain/address).
# If both are set, Resend is preferred.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Sunbuild
# RESEND_REPLY_TO=you@example.com

# Google SMTP (Nodemailer) — for local / paid Render
# For Gmail: enable 2-Step Verification, then create an App Password
# (Google Account → Security → App passwords). Paste the 16-char password
# into SMTP_PASSWORD (spaces optional). Restart after changes.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Sunbuild
SMTP_REPLY_TO=your-email@gmail.com

# Google Calendar OAuth (server-side only — never NEXT_PUBLIC_*)
# Create OAuth client in Google Cloud Console with redirect URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/calendar/callback

# Microsoft To Do OAuth (server-side only — never NEXT_PUBLIC_*)
# Create an app in Azure Portal → Microsoft Entra ID → App registrations.
# Add redirect URI below. API permissions: Tasks.ReadWrite, User.Read, offline_access.
# MICROSOFT_TENANT_ID:
#   consumers = personal Microsoft accounts only (Matches Audience: Personal)
#   organizations = work/school accounts only
#   common = both (Requires Audience: Accounts in any org + personal)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=consumers
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/microsoft/todo/callback

# WhatsApp Cloud API (Meta) — server-side only, never NEXT_PUBLIC_*
# Webhook URL: ${APP_URL}/api/whatsapp/webhook (same Next.js app)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Required to verify POST signatures (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=

# Twilio SMS (server-side only — never NEXT_PUBLIC_*)
# Same Next.js app. Do NOT create a separate Twilio API service or domain.
# Browser sends via relative /api/twilio/send
# Twilio webhooks use APP_URL:
#   ${APP_URL}/api/twilio/status
#   ${APP_URL}/api/twilio/inbound
#
# TWILIO_MODE=trial | production
# Trial (current official Twilio free trial):
#   Required: TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, APP_URL
#   Required: TWILIO_PHONE_NUMBER = the exact “Twilio trial number” shown as From
#             on Console → Messaging → Try out SMS (needed to avoid error 572003).
#             This is Twilio’s assigned trial sender — not a purchased number and
#             not the recipient’s personal mobile.
#   Optional: TWILIO_TRIAL_TEMPLATE (default sms_internal_alerts)
#   Body sent to Twilio must be a whitelist template id (not custom CRM text).
#   Recipients must be verified in Twilio Console → Messaging → Try out SMS.
# Production:
#   Required: TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER
#   Optional: TWILIO_MESSAGING_SERVICE_SID (preferred over direct From when set)
# TWILIO_ACCOUNT_SID must be a SINGLE AC… value (34 chars). Do not paste it twice.
TWILIO_MODE=trial
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_TRIAL_TEMPLATE=sms_internal_alerts
# Trial: copy From from Console → Try out SMS (Twilio trial number), e.g. +1…
# Production: purchased Twilio number owned by the account
TWILIO_PHONE_NUMBER=
# Optional production upgrade — preferred over TWILIO_PHONE_NUMBER when set
# TWILIO_MESSAGING_SERVICE_SID=

# Production checklist:
# - Use PostgreSQL (not SQLite) and rotate BETTER_AUTH_SECRET
# - Set APP_URL / NEXT_PUBLIC_APP_URL / BETTER_AUTH_URL to https://your-domain
#   (Render example: https://sunbuild.onrender.com — do NOT use PORT)
# - Configure RESEND_API_KEY on Render Free (SMTP ports are blocked), or SMTP_* on paid hosts — .env.local is local-only
# - Set GOOGLE_* and update GOOGLE_REDIRECT_URI to your production callback URL
# - Set MICROSOFT_* and update MICROSOFT_REDIRECT_URI to your production callback URL
# - Set WHATSAPP_* (phone number id, access token, verify token, app secret)
#   and point Meta webhook at ${APP_URL}/api/whatsapp/webhook
# - Trial SMS: TWILIO_MODE=trial, TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN,
#   TWILIO_TRIAL_TEMPLATE=sms_internal_alerts, APP_URL, and TWILIO_PHONE_NUMBER
#   = Console Try out SMS → From (Twilio trial number).
# - Production SMS later: TWILIO_MODE=production + purchased TWILIO_PHONE_NUMBER
#   (or TWILIO_MESSAGING_SERVICE_SID). Never NEXT_PUBLIC_*.
#   Point Twilio webhooks at ${APP_URL}/api/twilio/status and
#   ${APP_URL}/api/twilio/inbound — same SUNBUILD app, no extra Render service.
# - Enable automated DB + uploads backups
# - Run `npx prisma db push` after pulling schema changes (AppSetting, twoFactor)
# Days ahead counted as Upcoming Deadlines on Jobs Management
JOBS_UPCOMING_DEADLINE_DAYS=30
# Budget utilization % that triggers a Jobs insight warning
JOBS_BUDGET_WARNING_PERCENT=85
